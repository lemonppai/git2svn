{
  "name": "git2svn",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node index.ts",
    "build": "esbuild index.ts --format=esm --outfile=dist/index.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "bin": {
    "git2svn": "bin/cli.js"
  },
  "keywords": [
    "git",
    "svn",
    "sync"
  ],
  "files": [
    "dist/index.js"
  ],
  "dependencies": {
    "@types/node": "^26.1.1",
    "app-root-path": "^3.1.0",
    "cfonts": "^3.3.1",
    "chalk": "^6.0.0",
    "inquirer": "^14.0.2",
    "log-symbols": "^7.0.1",
    "marked": "^18.0.9",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
