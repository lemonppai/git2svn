{
  "name": "git2svn",
  "version": "0.3.0",
  "description": "Git ↔ SVN 双向镜像 CLI：把 Git 分支同步到 SVN，或把 SVN 内容提交回 Git，支持项目清单、增量工作副本、非交互模式与变更统计",
  "type": "module",
  "license": "MIT",
  "author": "九林 <lemonppai@qq.com>",
  "bin": {
    "git2svn": "bin/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonppai/git2svn.git"
  },
  "keywords": [
    "git",
    "svn",
    "sync",
    "mirror",
    "bidirectional",
    "subversion",
    "cli",
    "双向同步"
  ],
  "scripts": {
    "start": "npm run build && node bin/cli.js",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/run.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "chalk": "^6.0.0",
    "inquirer": "^14.0.2",
    "log-symbols": "^7.0.1",
    "marked": "^18.0.9",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
